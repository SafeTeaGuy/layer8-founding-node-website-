# Layer8 Founding Node Website — environment variables
# Phase 1 (this phase) needs none of these; they're documented now because
# Phase 2 (Orders and Checkout) will require them.

# Stripe (test mode only until the founder authorizes production payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (receipts, magic-link sign-in)
RESEND_API_KEY=

# Database (order/entitlement storage, added in Phase 2)
DATABASE_URL=
